post_install() {
  echo ""
  echo "Antigravity CLI has been installed!"
  echo ""
  echo "Usage:"
  echo "  agy              Start interactive CLI"
  echo "  agy --help       Show help"
  echo "  agy --version    Show version"
  echo ""
  echo "Desktop launcher has been installed."
  echo "You can find 'Antigravity CLI' in your application menu."
  echo ""
}

post_upgrade() {
  echo ""
  echo "Antigravity CLI has been updated to ${pkgver}!"
  echo ""
}
